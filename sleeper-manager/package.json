{
  "name": "sleeper-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated fantasy football manager for a Sleeper team.",
  "scripts": {
    "check": "node src/cli.js check",
    "lineup": "node src/cli.js lineup",
