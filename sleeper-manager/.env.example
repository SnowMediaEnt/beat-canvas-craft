# ---------------------------------------------------------------------------
# Sleeper account
# ---------------------------------------------------------------------------
# Your Sleeper username or the email you log in with.
SLEEPER_USERNAME=
# Your Sleeper password. Only needed for the browser automation that actually
# makes changes. Reading stats needs no password at all.
SLEEPER_PASSWORD=
# Optional. If you are in more than one league, pin the one to manage.
# Leave blank and the first league found for the season is used.
SLEEPER_LEAGUE_ID=

# ---------------------------------------------------------------------------
# What the bot is allowed to do on its own
# ---------------------------------------------------------------------------
# true  = the bot sets your lineup automatically
# false = the bot only emails you what it would change
AUTO_SET_LINEUP=false
# true  = the bot puts in waiver claims automatically
AUTO_CLAIM_WAIVERS=false
# Never automate trades. Left here so the intent is explicit.
AUTO_TRADES=false

# A player projected to beat your current starter by less than this many points
# is not worth a move. Stops pointless churn.
LINEUP_SWAP_THRESHOLD=1.5
# Most waiver claims to submit in one run.
MAX_WAIVER_CLAIMS=2
# Percent of your FAAB budget to bid on a top target.
FAAB_MAX_BID_PCT=15

# ---------------------------------------------------------------------------
# Email alerts
# ---------------------------------------------------------------------------
ALERT_EMAIL_TO=
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# For Yahoo and Gmail this is an "app password", not your normal password.
SMTP_PASS=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Keep the browser visible while debugging. Set false on the server.
HEADLESS=true
TIMEZONE=America/New_York
